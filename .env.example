# Copy to .env, fill in, then: set -a; source .env; set +a

# Option A: Gemini API key from Google AI Studio (local development)
GEMINI_API_KEY=

# Option B: Vertex AI (what Cloud Run uses; customer data is not used for training)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
# Prerequisite mapping is the core judgment, so it reasons more than the other calls
GEMINI_MAP_THINKING_LEVEL=medium

# Storage: memory (JSON snapshot in DATA_DIR) for dev, firestore in production
STORE=memory
DATA_DIR=.data

# Look up courses on bulletin.sfsu.edu (falls back to a built-in snapshot when off or unreachable)
BULLETIN_LIVE=1
# Class view shows a concept only once this many students have answered
MIN_CELL_STUDENTS=5

# demo = anonymous per-browser ids (hackathon); firebase = verify Firebase ID tokens
AUTH_MODE=demo

# Force the offline heuristic engine even if a key is set
# THROUGHLINE_OFFLINE=1

# --- Production (set by .github/workflows/deploy.yml; see docs/GUIDE.md) ---
# Background builds: inline (local thread pool) or cloudtasks (durable, production)
# BUILD_QUEUE=cloudtasks
# PUBLIC_URL=https://throughline-96823963383.us-central1.run.app
# TASKS_INVOKER_SA=throughline-tasks@sf-hacks-tutor.iam.gserviceaccount.com
# LOG_FORMAT=json
# AUTH_MODE=firebase
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# ALLOWED_EMAIL_DOMAINS=sfsu.edu
